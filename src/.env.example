# Snowflake account identifier from your account URL/account details (not a full URL)
SNOWFLAKE_ACCOUNT=YOUR_ACCOUNT_IDENTIFIER
SNOWFLAKE_USER=YOUR_LOGIN_NAME
# Optional: omit PASSWORD to use browser-based login (recommended where supported)
# SNOWFLAKE_PASSWORD=
# Optional role with CREATE DATABASE / WAREHOUSE privileges
# SNOWFLAKE_ROLE=ACCOUNTADMIN
